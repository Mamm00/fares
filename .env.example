# PostgreSQL connection string
# Local dev: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production: your hosted Postgres URL (Neon, Supabase, Vercel Postgres…)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Admin panel password — change this before going live
ADMIN_PASSWORD=fares2025

# Secret used to sign admin session cookies (any long random string)
ADMIN_SECRET=change-me-to-a-long-random-string
